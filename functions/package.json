{
  "name": "functions",
  "version": "1.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo \"(placeholder) run linters here\"",
    "serve": "firebase emulators:start --only functions",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest --runInBand --detectOpenHandles --testPathPattern \\.unit\\.test\\.ts$",
    "test:integration": "jest --runInBand --detectOpenHandles --testPathPattern \\.integration\\.test\\.ts$",
    "test:emulator": "firebase emulators:exec --project=ozen-staging-2025 --only functions,firestore,storage \"npm run test:integration\""
  },
  "dependencies": {
    "@google-cloud/kms": "^3.8.0",
    "express": "^4.22.1",
    "firebase-admin": "^11.11.1",
    "firebase-functions": "^4.9.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "axios": "^1.13.2",
    "firebase-functions-test": "^0.3.3",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.3"
  }
}
