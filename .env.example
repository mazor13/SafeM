# Environment example for OZEN
VITE_APP_NAME=OZEN
VITE_FIREBASE_PROJECT=handy-compass-477613-a4
VITE_SUPPORT_EMAIL=support@ozen.io
# Firebase config (client-side) - fill from Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=handy-compass-477613-a4
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# External services
VITE_OPENAI_API_KEY=
VITE_SENDGRID_API_KEY=
VITE_TWILIO_SID=

# KMS/Signing config (PoC: will use Cloud KMS)
# Full resource name, e.g. projects/<project>/locations/europe-west1/keyRings/ozen-keyring/cryptoKeys/ozen-signing-key
KMS_KEY_NAME=

# CI: The GitHub Actions workflow expects the GCP service account JSON to be saved
# in the repository secrets as GCP_SA_KEY
