rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    match /organizations/{orgId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.token.organizationId == orgId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isAuthenticated() && request.auth.token.organizationId == orgId && request.auth.token.role == 'org_admin');
      allow delete: if isSuperAdmin();
    }

    match /inspections/{inspectionId} {
      allow read: if isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.organizationId == resource.data.organizationId ||
        request.auth.token.clientId == resource.data.clientId
      );

      allow create: if isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.organizationId == request.resource.data.organizationId ||
        request.auth.token.role == 'inspector'
      );

      allow update: if isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        (request.auth.token.role == 'inspector' && resource.data.inspectorId == request.auth.uid)
      );

      allow delete: if isSuperAdmin();
    }

    match /documents/{docId} {
      allow read: if isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.organizationId == resource.data.organizationId ||
        request.auth.token.clientId == resource.data.clientId
      );

      allow create: if isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.organizationId == request.resource.data.organizationId
      );

      allow update, delete: if false; // documents immutable after creation
    }

    // Audit log: write-only for authenticated users
    match /audit_log/{logId} {
      allow create: if isAuthenticated();
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.token.organizationId == resource.data.organizationId);
      allow update, delete: if false;
    }
  }
}
